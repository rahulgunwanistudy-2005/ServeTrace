# ServeTrace environment. Copy to .env and fill in. Never commit .env.

# Affidavit extraction provider. "none" makes the app fully usable with manual entry.
LLM_PROVIDER=none

# Only read when LLM_PROVIDER matches.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Extraction model, per provider. Pinned here rather than in code so a model can be
# changed without a deploy of new code.
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-5

# When true, the server refuses uploads and serves bundled demo cases only.
DEMO_ONLY=false

# Upload ceiling in megabytes.
MAX_UPLOAD_MB=15

# Comma-separated allowed browser origins. Empty means same-origin only.
CORS_ORIGINS=

# NYC GeoSearch base URL (free, no key).
GEOSEARCH_URL=https://geosearch.planninglabs.nyc/v2/search

# Rate limit for the routes that cost money per call (/api/extract, /api/geocode).
# Sustained requests a minute per client, and how many may be spent at once.
# 0 requests a minute disables the limit entirely.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Proxies in front of the app whose X-Forwarded-For entries can be believed.
# 0 means use the peer address and ignore the header. On Render, set this to 1,
# or every user shares one bucket because every request arrives from the proxy.
RATE_LIMIT_TRUSTED_HOPS=0

# --- v1.1 ---------------------------------------------------------------------------
# Shown in /api/health, the footer and every PDF. Normally left to the code's default.
# APP_VERSION is a constant in backend/app/config.py, not an environment setting.

# Whether real court papers may be uploaded to this deployment. false shows a blocking
# "demos and synthetic data only" notice. Set true ONLY on an LLM plan whose terms
# exclude training on inputs (free tiers may not) - verify the provider's terms first.
LLM_REAL_DATA_ALLOWED=false

# /api/extract has its own budget: a batch upload calls it once per file.
EXTRACT_RATE_LIMIT_PER_MINUTE=60
EXTRACT_RATE_LIMIT_BURST=6
MAX_EXTRACT_PAGES=25
MAX_BATCH_AFFIDAVITS=200

# Anonymous day-level usage counts and the /attorneys contact form. Off unless all three
# are set. The service-role key bypasses row-level security: keep it server-side only.
METRICS_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
LEADS_PER_HOUR=5
